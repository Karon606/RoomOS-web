
// ============================================================
// schema.prisma — RoomOS 2.0 완성본
// 총 13개 테이블 / Phase 1 전체
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUM
// ============================================================

enum UserRole {
  OWNER
  MANAGER
  STAFF
  LIMITED_STAFF   // 제한 스태프 — 재고 입력 담당, 금액·매출 은닉(오류신고 65992b0a)
}

// 앱 전체 접근 상태 (베타 게이팅) — 영업장 역할(UserRole)과 별개
enum AccessStatus {
  PENDING   // 가입했으나 운영자 승인 대기 (기능 잠김)
  APPROVED  // 승인됨 (정상 사용)
  REJECTED  // 거절/차단
}

// 영업장 참여 요청 상태 (D — 사용자가 코드 입력 → 영업장 운영자 승인)
enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactType {
  PHONE
  LANDLINE
  KAKAO
  LINE
  WECHAT
  TELEGRAM
  FACEBOOK
  SNAPCHAT
  UNDEFINED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum LeaseStatus {
  WAITING_TOUR
  TOUR_DONE
  RESERVED
  ACTIVE
  CHECKOUT_PENDING
  CHECKED_OUT
  CANCELLED
  NON_RESIDENT
}

enum PaymentTiming {
  PREPAID
  POSTPAID
}

enum RegistrationStatus {
  REGISTERED
  NOT_REPORTED
  EXEMPTED
}

enum FinancialAccountType {
  BANK_ACCOUNT
  CREDIT_CARD
  DEBIT_CARD
  PREPAID
}

enum SettleStatus {
  SETTLED
  UNSETTLED
}

// ============================================================
// [1] User
// ============================================================

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  realName  String?
  phone     String?
  address   String?
  avatarUrl String?
  // ── 접근 제어 (베타 게이팅 / 운영자) ──
  status       AccessStatus @default(PENDING) // 신규 가입 = 승인 대기. 기존 사용자는 마이그레이션에서 APPROVED 백필.
  isSuperAdmin Boolean      @default(false)    // 앱 전체 운영자(env SUPER_ADMIN_EMAILS 와 병행)
  approvedAt   DateTime?
  approvedBy   String?      @db.Uuid           // 승인/거절한 운영자 user id
  inviteCode   String?                         // 가입 시 사용한 초대코드(있으면)
  // AI(제미나이) 본인 API 키 — 소유한 모든 영업장에 적용(BYOK). 서버 전용, 클라엔 마스킹만
  geminiApiKey String?
  geminiModel  String?                         // 선택 모델 ID (null = 기본 gemini-2.5-flash)
  geminiRestoreModel String?                   // pro 한도로 flash 전환 시 복귀 제안할 모델
  geminiRestoreAt    DateTime?                 // 무료 한도 초기화 예상 시각(태평양시 자정) — 지나면 복귀 제안
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyRoles   UserPropertyRole[]
  ownedProperties Property[]
  joinRequests    JoinRequest[]
  statusLogs      TenantStatusLog[]

  @@map("users")
}

// ============================================================
// [2] Property
// ============================================================

model Property {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  address     String?
  phone       String?
  description String?
  joinCode    String?   @unique  // 영업장 참여 코드 — 사용자가 입력하면 운영자에게 참여 요청 전송
  publicSlug  String?   @unique  // 공개 랜딩 페이지 slug (예: 'thestayjegi') — /members/<slug> + 트래픽 매칭용
  isActive         Boolean   @default(true)
  acquisitionDate      DateTime? @db.Date
  prevOwnerCutoffDate  DateTime? @db.Date
  roomTypeOptions    String?   // 방타입 목록 (콤마 구분, 예: "원룸,미니룸,복층")
  roomTierOptions    String?   // 호실 등급 목록 (콤마 구분, 예: "스탠다드,실속형,프리미엄") — 방 타입과 별개 차원
  windowTypeOptions  String?   // 창문 유형 목록 (콤마 구분, 기본값: "WINDOW,NO_WINDOW")
  directionOptions   String?   // 방향 목록 (콤마 구분, 예: "북향,동향,남향,서향")
  incomeCategories   String?   // 부가수익 카테고리 (콤마 구분)
  expenseCategories  String?   // 지출 카테고리 (콤마 구분)
  requestCategories  String?   // 요청·컴플레인 카테고리 (콤마 구분, 비면 기본 5종 — 2026-07-27)
  // 재고관리에 추적·표시할 카테고리 설정 (JSON: [{"cat":"부식비","alias":"식료품"},...]).
  // cat = 지출 카테고리(expenseCategories 중), alias = 재고관리 표시명. 순서 = 표시 순서.
  // null 이면 기본값(부식비→식료품·소모품비→소모품·폐기물 처리비→폐기물 처리용품).
  inventoryCategories String?
  paymentMethods     String?   // 결제 수단 목록 (콤마 구분)
  defaultDeposit   Int?      // 기본 보증금
  defaultCleaningFee Int?    // 기본 청소비
  defaultAreaM2    Float?    // 기본 전용면적(㎡) — 실거주 확인서 등 서류 기본값. 호실별 areaM2 가 비었을 때 사용
  // 단기 입실 정책 템플릿 (JSON, lib/shortStay.ShortStayPolicy) — 영업장별 수치.
  // null = 정책 미사용(기본). 예: {"enabled":true,"unitDays":7,"minUnits":1,"thresholdDays":30,"multiplier":1.5,"cleaningFee":20000}
  shortStayPolicy  Json?
  bankAccount      String?   // 입금 계좌번호 (월세 영수증 납부방법에 자동 반영). 예 "○○은행 123-456 (예금주)"
  // 예약금 처리 영업장 기본값 — 'deposit'(보증금 대체)|'prepaid'(이용료 선납)|'none'(안 받음). null=deposit 해석.
  // 예약 폼 프리셋일 뿐 강제 아님(예약별 LeaseTerm.reservationDepositMode로 오버라이드).
  reservationDepositMode String?
  contactLeadDays  Int       @default(14)  // 잠재고객 연락 알림 — 입주 희망일 며칠 전부터(운영자별 기준, 기본 14)
  // 퇴실 환불 규정 (영업장별) — 조기 퇴실 시 환불액 산정. 비면 위약금/고정 1일당 없음.
  refundPenaltyWithinDays Int?     // 입주 후 N일 이내 퇴실 시 위약금 적용 (null/0 = 위약금 없음)
  refundPenaltyPct        Int?     // 위약금율 — 잔 입실료의 P%
  refundDailyRate         Int?     // 1일당 입실료 차감액(고정). null = 월 이용료 ÷ 30 자동
  refundDeductCleaning    Boolean  @default(false)  // 환불 시 청소비(lease.cleaningFee) 차감 — 코드 미사용(되돌리기 여지로 보존)
  // 청소비를 보증금 안의 몫으로 받는 영업장인지(운영자 확정 2026-08-10). true 면 입실 때 받은
  // 청소비가 계약 보증금의 일부를 채운 것으로 판정한다(lib/depositComposition 정본).
  cleaningFeeInDeposit    Boolean  @default(false)
  refundClauseInContract  Boolean  @default(true)   // 계약서에 환불 규정 조항({{환불규정}})을 자동 표시할지
  // 계약서 (영업장별 별도 운영)
  contractTemplate Json?     // 섹션 본문 + 추가 표시 옵션. shape: { title, sections: [{ title, items: string[] }], oathText }
  // 잔여 소지품 임의처분 동의서 — 계약서와 함께 출력되는 별도 서류. shape: { enabled, days, title, body }
  disposalConsentTemplate Json?
  businessInfo     Json?     // 사업자 정보. shape: { name, registrationNo, ceoName, address }
  stampDriveFileId String?   // 도장 PNG (Drive 파일 ID, 투명 배경 권장)
  calendarToken    String?   @unique  // 캘린더 구독(.ics) 피드 비밀 토큰 — 납부예정·퇴실예정 자동 동기화
  logoDriveFileId  String?   // 영업장 로고 (Drive 파일 ID, 계약서 헤더 좌측 — 투명 배경 서류용)
  appLogoDriveFileId String? // 앱 로고 (Drive 파일 ID, 헤더 영업장명 앞 원형 표시 — 배경 있는 일반 로고)
  floorPlanData    Json?     // 도면 데이터. shape: { elements: FloorPlanElement[], canvasWidth, canvasHeight }
  floorPlanPrevData Json?    // 직전 저장본 — 저장 직후 토스트 적용취소용(감사 백로그 2026-07-10, 스왑 방식이라 재실행도 가능)
  createdAt        DateTime  @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  userRoles         UserPropertyRole[]
  joinRequests      JoinRequest[]
  rooms             Room[]
  tenants           Tenant[]
  leaseTerms        LeaseTerm[]
  financialAccounts FinancialAccount[]
  paymentRecords    PaymentRecord[]
  expenses          Expense[]
  expenseOrders     ExpenseOrder[]
  extraIncomes      ExtraIncome[]
  statusLogs        TenantStatusLog[]
  tenantRequests    TenantRequest[]
  marketSurveys     MarketSurvey[]
  recurringExpenses RecurringExpense[]
  trackedItems      TrackedItem[]
  storageLocations  StorageLocation[]
  checklists        Checklist[]
  reserveTransactions ReserveTransaction[]
  depositRefunds      DepositRefund[]
  contractFiles       ContractFile[]
  contractShareLinks  ContractShareLink[]
  assetItemOrders     AssetItemOrder[]
  residenceCertFiles  ResidenceCertFile[]
  rentReceiptFiles    RentReceiptFile[]
  itemNameAliases     ItemNameAlias[]
  itemSpecOptions     ItemSpecOption[]
  itemNameMergeRuns   ItemNameMergeRun[]
  assetAssignmentLogs AssetAssignmentLog[]
  smsTemplates        SmsTemplate[]
  smsLogs             SmsLog[]
  aiUsages            AiUsage[]
  photoCategories     PropertyPhotoCategory[]
  propertyPhotos      PropertyPhoto[]
  roomStays           RoomStay[]

  cleanings          RoomCleaning[]
  documentFieldOverrides DocumentFieldOverride[]
  @@map("properties")
}

// 품명 별칭/통일 — 영수증 OCR 학습·자동완성·환경설정 품명 병합이 공유.
// aliasKey(정규화된 원문) → preferredLabel(통일명). 같은 영업장 내 유일.
// 품목 세부스펙 사전 (2026-07-06, 신고 ba9feb6b) — 단가에 영향 없는 구분 정보(폭·두께·색상·사이즈)의
// 품목별 재사용 옵션. 지출 저장 시 자동 적립(captureItemSpecOptions), 설정에서 수정·삭제.
model ItemSpecOption {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  itemLabel  String   // 품목명 — 이 품목에서 재사용할 세부스펙
  label      String   // 세부스펙 표기 (예: '폭 183cm · 두께 1.8T', '싱글/그레이')
  createdAt  DateTime @default(now())

  @@unique([propertyId, itemLabel, label])
  @@index([propertyId, itemLabel])
  @@map("item_spec_options")
}

model ItemNameAlias {
  id             String   @id @default(uuid()) @db.Uuid
  propertyId     String   @db.Uuid
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  aliasKey       String   // 정규화된 원문(소문자·공백정리) — 매칭 키
  aliasLabel     String   // 원문 표시값(그대로)
  preferredLabel String   // 통일된 선호명
  source         String   @default("ocr")  // ocr | merge | manual
  hitCount       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([propertyId, aliasKey])
  @@map("item_name_aliases")
}

// 품명 병합 이력 — 환경설정 'AI 품명 병합' 1회 실행 단위. 적용취소(undo) 시 완전 원복용.
model ItemNameMergeRun {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @db.Uuid
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  canonical   String   // 통일된 대표명
  affected    Json     // [{ expenseId, oldLabel }] — 라벨 변경된 지출(되돌릴 때 원복)
  newAliasKeys String[] // 이 병합으로 새로 생성한 별칭 키(되돌릴 때만 삭제, 기존 별칭은 보존)
  memberCount Int      @default(0)
  undoneAt    DateTime?
  createdAt   DateTime @default(now())

  @@index([propertyId])
  @@map("item_name_merge_runs")
}

// 비품 배정 변경 이력 — 어느 방/공용부 ↔ 어디로 옮겼는지 타임라인(상세 풀화면 §21.5).
// 재집계·라벨변경과 무관하게 이력 보존을 위해 itemLabel·표시명을 당시 값으로 박아둔다.
model AssetAssignmentLog {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @db.Uuid
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  itemLabel   String?  // 당시 품목명(이력 조회 키)
  // 당시 규격 — 카드 식별은 (라벨 + 규격)이라 라벨만으로 조회하면 색상·사이즈가 다른 카드끼리 이력이 섞인다(5853a0ff).
  // 셋 다 null = '규격 미상'(컬럼 추가 전 기록 중 라벨에 규격이 2종 이상이라 백필 불가였던 것) —
  // 조회에선 그 라벨 전 카드에 보이되(기록 보존) 되돌리기는 막는다(어느 규격 행을 되돌릴지 알 수 없으므로).
  specValue   Float?
  specUnit    String?
  specText    String?
  fromKind    String   // none | room | location | common
  fromLabel   String?  // 당시 표시명(방번호·공용부명)
  toKind      String
  toLabel     String?
  qty         Float?   // 이동 수량(있으면)
  assignedAt  DateTime? // 운영자가 지정한 배정일(방/공용부 배정 시) — 이력 표시는 이 값 우선
  createdAt   DateTime @default(now())

  @@index([propertyId, itemLabel])
  @@map("asset_assignment_log")
}

// ============================================================
// 미납 안내 문자 — 템플릿 + 발송 시도 이력 (/docs/stayeum_payment_spec.md Phase 1)
//   실제 발송은 운영자 폰의 문자앱(sms: 링크)에서 이뤄지므로 이력은 '발송 시도' 기록.
//   sentVia 는 Phase 2(솔라피 등 API 발송) 확장 대비.
// ============================================================
// 공용 AI 키 월 사용량 — 영업장별 무료 체험 카운터(본인 키 등록 시 카운트 안 함)
model AiUsage {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  month      String   // 'YYYY-MM'
  count      Int      @default(0)

  @@unique([propertyId, month], map: "ai_usage_property_month")
  @@map("ai_usage")
}

model SmsTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String   // "1차 안내" 등
  body       String   // 변수({이름}{호수}{미납금액}{납기일}{경과일수}{계좌번호}) 포함 원문
  kind       String   @default("unpaid")  // 'unpaid' 미납 안내 / 'notice' 단체 공지 (R4)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  logs       SmsLog[]

  @@index([propertyId, sortOrder])
  @@map("sms_templates")
}

model SmsLog {
  id           String    @id @default(uuid()) @db.Uuid
  propertyId   String    @db.Uuid
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId     String    @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaseTermId  String?   @db.Uuid
  templateId   String?   @db.Uuid
  template     SmsTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  renderedBody String    // 변수 치환 완료된 실제 본문
  overdueAmount Int?
  overdueDays   Int?
  paymentCheckConfirmedAt DateTime?  // 발송 전 '입금내역 확인' 다이얼로그 통과 시각
  sentVia      String    @default("manual_sms")  // Phase 2: 'solapi' 등
  kind         String    @default("unpaid")       // 'unpaid' / 'notice' — 단체 공지 이력 구분 (R4)
  createdAt    DateTime  @default(now())

  @@index([propertyId, createdAt])
  @@index([tenantId, createdAt])
  @@map("sms_logs")
}

// ============================================================
// [3] UserPropertyRole
// ============================================================

model UserPropertyRole {
  id        String   @id @default(uuid()) @db.Uuid
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("user_property_roles")
}

// ============================================================
// [4] Room
// ============================================================

model Room {
  id         String     @id @default(uuid()) @db.Uuid
  roomNo     String     // TEXT — 하드코딩 금지, 영업장별 자유 구성
  type       String?
  tier       String?    // 호실 등급 (스탠다드/실속형 등) — Property.roomTierOptions 중 하나
  memo       String?
  baseRent             Int        @default(0)
  scheduledRent        Int?                   // 예약된 변경 이용료 (가격 예약 시스템)
  rentUpdateDate       DateTime?  @db.Date    // 가격 적용 예정일
  nonResidentRent      Int?                   // 비거주 월이용료 (null = 비거주 옵션 비활성)
  nonResidentScheduled Int?                   // 비거주 예약 이용료
  nonResidentRentDate  DateTime?  @db.Date    // 비거주 예약 이용료 적용 예정일
  isVacant   Boolean    @default(true)
  // 공개 소개 페이지 갤러리에 이 방 사진을 노출할지 — 운영자가 호실 관리에서 직접 켠다(사진 없으면 못 켬).
  // 공실 여부와 독립(공실이어도 운영자가 켜야 올라가고, 방이 차도 자동으로 안 내려간다 — 알림만 제안). 2026-07-25
  showOnSite Boolean    @default(false)
  // 방 특성 (2026-07-06, 운영자 요청 — 415 창고·사무실 사례)
  noMoveInReport    Boolean @default(false)  // 전입신고 불가 방 — 등록 시 경고 + 카드 배지
  nonResidentVacant Boolean @default(true)   // 비거주 점유 시 공실로 표시할지 (false = 창고·사무실처럼 점유로 취급)
  areaPyeong Float?
  areaM2     Float?
  floor      String?                    // 층 (자동 유추 또는 수동 입력)
  windowType String?
  direction  String?
  createdAt     DateTime @default(now())
  updatedAt  DateTime   @updatedAt

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  photos     RoomPhoto[]
  leaseTerms LeaseTerm[]
  expenses   Expense[]
  roomStays  RoomStay[]
  cleanings  RoomCleaning[]

  @@unique([propertyId, roomNo])
  @@map("rooms")
}

// 방 청소 이력 (2026-08-05, 신고 b21e4e98).
//
// "어떤 방이 언제 청소했고 청소를 안 했는지 헷갈린다" 가 신고 본문이다. 상태 관리 문제라
// 회계에 접점이 없다. **이 모델은 돈을 만들지 않는다.** 돈은 기존 둘만 만든다 —
// 받은 청소비는 ExtraIncome, 나간 비용은 Expense. 여기는 그 Expense 를 가리키기만 한다.
// 금액을 복사해 두지 않는 이유는 사본이 갈리기 때문이다. 지출에서 금액을 고치면 여기가 안 따라온다.
//
// 기존 모델에 못 얹는 이유 — Expense 는 금액 0 을 거부해 직접 청소(비용 없음)를 못 담고,
// Checklist 는 roomId 가 없고 주기 반복 전제라 건별 이력이 아니며, Room 에 플래그만 붙이면
// "언제 누가 얼마에" 가 통째로 날아간다. LeaseTerm 에 매달면 입실 중 청소와 도배 후 청소를 못 담는다.
model RoomCleaning {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String    @db.Uuid
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId     String    @db.Uuid
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  // 어느 퇴실 건인지 — 퇴실 청소일 때만. 그 외(도배 후·입실 중 요청)는 null
  leaseTermId String?  @db.Uuid
  leaseTerm   LeaseTerm? @relation(fields: [leaseTermId], references: [id], onDelete: SetNull)

  reason     String    @default("CHECKOUT")   // CHECKOUT | AFTER_WORK | DURING_STAY | OTHER
  status     String    @default("PLANNED")    // PLANNED | DONE | SKIPPED
  scheduledDate DateTime? @db.Date
  doneDate      DateTime? @db.Date
  performer     String?   // SELF | VENDOR | THIRD_PARTY
  performerName String?   // 업체명·사람 이름 자유 입력. 청소 담당 계정이 앱에 없다
  // 비용이 있으면 Expense 1건을 만들고 그 id 를 건다. 금액은 여기 복사하지 않는다(2단계)
  expenseId  String?   @db.Uuid
  // 그 비용을 받은 청소비에서 부담하는가 — **회계 처리가 아니라 표식이다.** 손익을 바꾸지 않는다(4단계)
  fromCleaningFund Boolean @default(false)
  memo       String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([propertyId, status])
  @@index([roomId, doneDate])
  @@index([leaseTermId])
  @@map("room_cleanings")
}

// ============================================================
// [5] RoomPhoto
// ============================================================

model RoomPhoto {
  id           String   @id @default(uuid()) @db.Uuid
  driveFileId  String?  // Google Drive 파일 ID (삭제/관리용)
  storageUrl   String   // 표시용 URL (Drive 썸네일 또는 구 Supabase URL)
  fileName     String?
  sortOrder    Int      @default(0)
  showOnSite   Boolean  @default(true)   // 공개 소개 페이지 노출 여부(사진 단위, 2026-07-25). 대표=공개 첫 장(자동)
  is360        Boolean  @default(false)  // 360 파노라마 사진 — 평면 목록에서 빼고 '360으로 보기'로만. 업로드 시 판정 저장
  createdAt    DateTime @default(now())

  roomId String @db.Uuid
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("room_photos")
}

// 공용·외관 사진 카테고리 (기본 세트 + 운영자 추가·수정·순서, 2026-07-25). 방이 아닌 영업장에 묶임
model PropertyPhotoCategory {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  photos     PropertyPhoto[]

  @@map("property_photo_categories")
}

// 공용·외관 사진 — RoomPhoto 와 동일 필드(공개 토글·순서·360·Drive) + 카테고리. 방 대신 영업장 소속
model PropertyPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  driveFileId String?  // Google Drive 파일 ID
  storageUrl  String   // 표시용 URL
  fileName    String?
  sortOrder   Int      @default(0)
  showOnSite  Boolean  @default(true)
  is360       Boolean  @default(false)
  createdAt   DateTime @default(now())

  categoryId String @db.Uuid
  category   PropertyPhotoCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  propertyId String @db.Uuid   // 조회 편의(카테고리 경유 없이 영업장 단위 필터)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_photos")
}

// ============================================================
// [6] Tenant
// ============================================================

model Tenant {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  englishName      String?
  email            String?
  birthdate        DateTime? @db.Date
  gender           Gender    @default(UNKNOWN)
  nationality      String?
  job              String?
  memo             String?
  isBasicRecipient Boolean   @default(false)
  smoking          Boolean   @default(false)   // 흡연 여부 (true=흡연) — 고객관리 입력, 계약서 자동반영
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  contacts       TenantContact[]
  smsLogs        SmsLog[]
  leaseTerms     LeaseTerm[]
  paymentRecords PaymentRecord[]
  statusLogs     TenantStatusLog[]
  requests       TenantRequest[]
  depositRefunds DepositRefund[]
  contractFiles  ContractFile[]
  contractShareLinks ContractShareLink[]
  extraIncomes   ExtraIncome[]
  residenceCertFiles ResidenceCertFile[]
  rentReceiptFiles   RentReceiptFile[]

  @@map("tenants")
}

// ============================================================
// [7] TenantContact
// ============================================================

model TenantContact {
  id                String      @id @default(uuid()) @db.Uuid
  contactType       ContactType @default(PHONE)
  contactValue      String
  isEmergency       Boolean     @default(false)
  emergencyRelation String?
  isPrimary         Boolean     @default(false)
  isHomeCountry     Boolean     @default(false)  // 본국 연락처 (국제 번호) — 외국인 입주자용
  countryCode       String?                       // ISO 3166-1 alpha-2 (KR, RU 등) — 본국 번호 포맷 기준
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_contacts")
}

// ============================================================
// [8] LeaseTerm
// ============================================================

model LeaseTerm {
  id                 String             @id @default(uuid()) @db.Uuid
  status             LeaseStatus        @default(ACTIVE)
  moveInDate         DateTime?          @db.Date
  moveOutDate        DateTime?          @db.Date
  expectedMoveOut    DateTime?          @db.Date
  rentAmount         Int                @default(0)
  depositAmount      Int                @default(0)
  cleaningFee        Int                @default(0)
  paymentTiming      PaymentTiming      @default(PREPAID)
  dueDay             String?            // "15", "말일" 등 자유 텍스트
  contactAlertDate   DateTime?          // 잠재고객 연락 알림 시작일 직접 지정 — 비우면 영업장 기본(입주 희망일 N일 전)
  overrideDueDay     String?            // 특정 월 임시 납부일
  overrideDueDayMonth String?           // 적용 대상 월 "YYYY-MM"
  overrideDueDayReason String?          // 조정 사유
  // 퇴실 정산(일할) — 선납 모델에서 퇴실일이 기간 중간이면 마지막 달 청구를 사용 일수만큼만.
  //   checkoutProratedAmount: 확정된 일할 청구액(원). null이면 일할 미적용(=풀 청구).
  //   checkoutProratedMonth: 위 금액이 적용되는 퇴실 달 "YYYY-MM". (lib/prorate calcCheckoutProration)
  // 설정 시 청구 엔진(rooms getRoomPaymentStatus·dashboard unpaid·page)이 그 달 청구를 이 값으로 덮어씀.
  checkoutProratedAmount Int?
  checkoutProratedMonth  String?
  // 퇴실 일할 정산 '적용취소'(롤백)용 — 적용 직전 스냅샷 {prevStatus, prevExpectedMoveOut, prevAmount, prevMonth}.
  // 적용은 status·expectedMoveOut·일할액을 한 번에 바꾸므로, 단일클릭 복원을 위해 직전값 보관. null이면 되돌릴 정산 없음.
  checkoutProrationUndo  Json?
  prevOwnerSettleMenu String            @default("auto")  // 양도인 정산 메뉴 노출 — auto|show|hide
  payMethod          String?
  cashReceipt        String?
  registrationStatus RegistrationStatus @default(NOT_REPORTED)
  contractUrl        String?
  contractOverride   Json?              // 입실자별 계약서 본문 덮어쓰기 (Property.contractTemplate 형식과 동일). null이면 영업장 공통 템플릿 사용
  // 계약서 발급물 표시값 오버라이드 (sparse — 존재하는 키만 덮음, lib/contractFieldOverrides 가 정본).
  // 수납·청구는 이 컬럼을 모른다. 계약서 렌더(화면·PDF·서명 링크 스냅샷) 전용 (운영자 승인 2026-08-05).
  contractFieldOverrides Json?
  // #8 앱서명 재사용: 마지막으로 받은 서명 이미지(dataURL). 계약서 출력 에디터가 이 값을 불러와 표시·재인쇄.
  signatureImageUrl  String?
  // 잔여 소지품 임의처분 동의서 별도 서명(dataURL) — 입실계약서 서명과 독립 저장(에디터 재표시·재인쇄용).
  disposalSignatureImageUrl String?
  // 그 서명 이미지를 받은 시각. 원격은 링크의 서명 시각과 같은 값, 대면은 서명 패드 확인 시각.
  // 계약일이 이 값으로 고정된다 — 없으면 발급 때마다 '오늘'이 찍혀 실제 서명일과 갈린다.
  signatureSignedAt         DateTime?
  disposalSignatureSignedAt DateTime?
  // 서명 시점 본문 격리. 서명 네 칸과 생사를 같이 한다 — 재서명 때 함께 null 이 된다.
  // 영업장 공통 템플릿이 바뀌어도 서명이 끝난 계약서는 절대 안 바뀌게 하는 칸이다(운영자 오더 2026-08-04).
  // 두 모양이 있다. 앱이 만든 본문을 서명받았으면 본문을 담고(origin REMOTE_LINK|IN_PERSON),
  // 서명 원본이 앱 밖(종이 스캔·과거 발급본)이면 본문 대신 그 파일을 가리킨다(origin SCAN|LEGACY_PDF).
  // 뒤쪽은 앱이 모르는 본문을 주장하지 않기 위한 것이고, 그 계약은 새 앱 발급본을 만들지 못한다.
  signedContractSnapshot    Json?
  cleanings                 RoomCleaning[]
  wishRooms          String?
  wishConditions     String?            // JSON: { floor?, windowType?, type?, direction? } — 호실 미지정 예약자용. "{}"이면 조건 무관(모든 빈 방 매칭)
  keepAlertAfterInquiry Boolean         @default(false)  // 입주 희망일이 지나도 알림 유지
  visitRoute         String?
  tourDate           DateTime?          @db.Date
  tourTime           String?            // 투어 예정 시각 "HH:MM"(KST). null=시간 미정 — 캘린더 피드가 시간 있으면 시각 지정 이벤트, 없으면 종일 이벤트
  // 단기 자동 퇴실 예정 전환 시각 — 크론이 퇴실일 하루 전 자동 전환하며 기록.
  // 값이 있으면 재전환 안 함(운영자가 수동으로 거주중 복귀 시 존중). 퇴실일 변경 시 null로 리셋(재무장).
  autoCheckoutAt     DateTime?
  inquiryAt          DateTime?          // 입실 문의 일시 (예약자 순번 기준)
  reservationConfirmedAt DateTime?      // 예약 확정 일시 (RESERVED → 확정 단계 진입 시점). null이면 일반 예약, non-null이면 예약 확정
  isShortTerm        Boolean            @default(false)  // 단기 희망. true면 폼 자동입력(room.baseRent, defaultDeposit/cleaningFee) 건너뛰고 수동 입력 강제
  // 단기 연장 이력·적용취소 스냅샷 — append-only 배열(운영자 승인 2026-07-20).
  // [{ at, prevRentAmount, newRentAmount, prevExpectedMoveOut, newExpectedMoveOut, prevStatus,
  //    prevAutoCheckoutAt, prevProration{amount,month,undo}, markerRecordId, undoneAt }] — null=연장 없음.
  shortStayExtensions Json?
  // 이 예약의 예약금 처리 모드 — 'deposit'|'prepaid'|'none'. null=영업장 기본값(Property.reservationDepositMode) 상속.
  // record(isDeposit)로 추론하지 않고 영속 — 선납 환불(record 소프트삭제) 후에도 '안 받음'과 구분(적대검증 발견 4).
  reservationDepositMode String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roomId String? @db.Uuid
  room   Room?   @relation(fields: [roomId], references: [id])

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  paymentRecords PaymentRecord[]
  statusLogs     TenantStatusLog[]
  depositRefunds DepositRefund[]
  contractFiles  ContractFile[]
  contractShareLinks ContractShareLink[]
  residenceCertFiles ResidenceCertFile[]
  rentReceiptFiles   RentReceiptFile[]
  discounts      RentDiscount[]   // #14 월세 할인(입주자별, 여러 개 가능)
  extraIncomes   ExtraIncome[]
  roomStays      RoomStay[]       // 거주 구간 이력(파생 — 현재 방의 진실은 roomId, 2026-07-28)
  documentFieldOverrides DocumentFieldOverride[]

  @@index([propertyId, status]) // 영업장별 현재 거주자 조회 최적화
  @@map("lease_terms")
}

// 거주 구간 이력 — 이사·퇴실에도 '어느 방에 언제부터 언제까지'가 남는 파생 테이블(아키텍트 설계 2026-07-28).
// 현재 방의 진실은 계속 LeaseTerm.roomId(청구·재고 로직 무접촉). 기록 지점: 입주 생성·호실 변경·퇴실 확정.
// LeaseTerm.roomId 와 열린 구간(endDate null)의 드리프트는 감지 스크립트로 봉합.
model RoomStay {
  id          String    @id @default(uuid()) @db.Uuid
  startDate   DateTime? @db.Date   // 구간 시작(입주일 또는 이사일)
  endDate     DateTime? @db.Date   // 구간 끝(이사·퇴실일). null = 현재 구간
  createdAt   DateTime  @default(now())

  leaseTermId String    @db.Uuid
  leaseTerm   LeaseTerm @relation(fields: [leaseTermId], references: [id], onDelete: Cascade)
  roomId      String    @db.Uuid
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  propertyId  String    @db.Uuid
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([roomId, startDate])
  @@index([leaseTermId])
  @@map("room_stays")
}

// #14 월세 할인 — 입주자(계약)별, 여러 개 중첩 가능.
//   discountType: 'amount'(원) | 'percent'(%) — percent는 그 달 기본 임대료 기준.
//   scope: 'permanent'(매월) | 'temporary'(startMonth~endMonth, YYYY-MM 포함).
//   여러 할인 합산은 그 달 임대료를 초과하지 않게 캡(계산은 lib/rentDiscount.ts 순수함수).
model RentDiscount {
  id           String    @id @default(uuid()) @db.Uuid
  leaseTermId  String    @db.Uuid
  leaseTerm    LeaseTerm @relation(fields: [leaseTermId], references: [id], onDelete: Cascade)
  discountType String    // 'amount' | 'percent'
  value        Int       // 원(amount) 또는 % (percent)
  scope        String    // 'permanent' | 'temporary'
  startMonth   String?   // 'YYYY-MM' (temporary)
  endMonth     String?   // 'YYYY-MM' (temporary)
  memo         String?
  createdAt    DateTime  @default(now())

  @@index([leaseTermId])
  @@map("rent_discounts")
}

// ============================================================
// [9] FinancialAccount
// ============================================================

model FinancialAccount {
  id              String               @id @default(uuid()) @db.Uuid
  type            FinancialAccountType
  brand           String
  alias           String?
  identifier      String?
  payDay          Int?
  cutOffDay       Int?
  owner           String?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  linkedAccountId String?            @db.Uuid
  linkedAccount   FinancialAccount?  @relation("CardToAccount", fields: [linkedAccountId], references: [id])
  linkedCards     FinancialAccount[] @relation("CardToAccount")

  expenses          Expense[]
  extraIncomes      ExtraIncome[]
  reserveLinks      ReserveTransaction[] @relation("ReserveLinkedAccount")
  recurringExpenses RecurringExpense[]

  @@map("financial_accounts")
}

// ============================================================
// [10] PaymentRecord
// ============================================================

model PaymentRecord {
  id             String   @id @default(uuid()) @db.Uuid
  targetMonth    String   // "YYYY-MM" 형식
  expectedAmount Int      @default(0)
  actualAmount   Int      @default(0)
  carryOver      Int      @default(0)
  seqNo          Int      @default(1)
  isPaid         Boolean  @default(false)
  isDeposit      Boolean  @default(false)
  isPrevOwner    Boolean  @default(false)  // 양도인 정산 — 이 달은 양도인이 받음 (현 소유주 장부·미납 제외)
  isBillingAdjust Boolean @default(false)  // 청구 조정 전표(단기 연장·감액 마커) — 수납이 아니라 청구 락 조정용. 표시·수납 집계에서 제외, 청구 락(_max expectedAmount)에는 반드시 포함.
  paymentConfirmedAt DateTime?  // 입금 확인 처리 시각 (Phase 2 CODEF 자동확인 대비 — /docs/stayeum_payment_spec.md)
  paymentConfirmedBy String?    // 'manual' | 'codef_auto'
  bankTxRef          String?    // Phase 2: CODEF 거래내역 매칭 키(중복 처리 방지)
  payDate        DateTime @db.Date
  payMethod      String?
  memo           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cashReceiptIssuedAt DateTime?   // 현금영수증 발행 시각 — 발행 표시 메타데이터(충당·잔액 수식 비관여, 오류신고 2bd8befa)
  deletedAt      DateTime? // 소프트삭제 — null=활성. 조회는 prisma 소프트삭제 익스텐션이 자동 필터.

  leaseTermId String    @db.Uuid
  leaseTerm   LeaseTerm @relation(fields: [leaseTermId], references: [id], onDelete: Cascade)

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([leaseTermId, targetMonth, seqNo])
  @@index([leaseTermId, targetMonth])
  @@index([propertyId, targetMonth])
  @@map("payment_records")
}

// ============================================================
// [11] Expense
// ============================================================

model Expense {
  id           String       @id @default(uuid()) @db.Uuid
  date         DateTime     @db.Date
  amount       Int
  category     String
  detail       String?
  vendor       String?
  vendorBizNo  String?      // 구매처 사업자등록번호(000-00-00000) — 영수증 인식·수기 입력, 동일 구매처 과거 행 보정 전파(운영자 요청 2026-07-23)
  memo         String?
  payMethod    String?
  settleStatus  SettleStatus @default(SETTLED)
  receiptUrl    String?
  financeName   String?
  receiptUrls   String?
  targetRoomId  String?
  // #1 관리비 묶음: 장부엔 1줄(합계)이지만 세부항목 내역을 보관. JSON [{name, amount, isVariable}]
  breakdownJson String?
  itemLabel    String?
  specValue    Float?
  specUnit     String?
  specText     String?   // 서술형 규격(1200x600mm 등) — 표시·자재 구분용, 계산 비관여 (2026-07-03)
  unitBasis    String?   // 입력 당시 단가 기준 'spec'|'qty' — 재열람 시 보존 (2026-07-03)
  qtyValue     Float?
  qtyUnit      String?
  receivedAt   DateTime?    // null = 수령 대기, not null = 수령 완료 (재고 계산에 반영)
  excludeFromInventory Boolean @default(false) // true면 재고 계산에서 제외 (지출 기록은 유지)
  // 한 품목을 방별로 분배해 여러 행으로 쪼갠 경우, 그 행들을 한 묶음으로 표시하기 위한 공통 ID.
  // null = 단일 행. 지출 목록에서 같은 값끼리 한 줄로 묶고 펼치면 방별 상세.
  allocationGroupId String? @db.Uuid
  // 합배송 주문 묶음: 한 주문(ExpenseOrder)에 속한 여러 지출(품목별·방별 분할 포함)을 묶는다.
  // isShipping=true 면 이 행이 그 주문의 '배송비' 별도 지출 라인.
  orderId      String?      @db.Uuid
  isShipping   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomId String? @db.Uuid
  room   Room?   @relation(fields: [roomId], references: [id])

  financialAccountId   String?            @db.Uuid
  financialAccount     FinancialAccount?  @relation(fields: [financialAccountId], references: [id])

  recurringExpenseId   String?            @db.Uuid
  recurringExpense     RecurringExpense?  @relation(fields: [recurringExpenseId], references: [id])

  order                ExpenseOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  receivedLocationId   String?            @db.Uuid
  receivedLocation     StorageLocation?   @relation("ExpenseReceivedLocation", fields: [receivedLocationId], references: [id], onDelete: SetNull)

  // 비품·자재 배정 위치(공용부 — 주방·화장실·복도 등 StorageLocation). 방(roomId)과 상호배타.
  assignedLocationId   String?            @db.Uuid
  assignedLocation     StorageLocation?   @relation("ExpenseAssignedLocation", fields: [assignedLocationId], references: [id], onDelete: SetNull)
  // 방/공용부 배정일 — 입력·수정 가능, 기본=배정하는 순간. null = 미배정 또는 배정일 미상.
  assignedAt           DateTime?          @db.Date
  // 공용 자재 — 페인트·공구처럼 두고두고 공용으로 쓰는 비품. 방/공용부에 배분하지 않음(미배정과 구분: '의도된 공용').
  isCommonAsset        Boolean            @default(false)

  reserveSettlements   ReserveTransaction[] @relation("ExpenseReserveSettlement")

  // confirmReceipt가 자동 생성한 점검들 (수령일 수정 시 동기화 대상)
  autoStockChecks      StockCheck[]

  @@index([propertyId, date])
  @@index([orderId])
  @@map("expenses")
}

// 합배송 주문 묶음 — 한 번 주문이 여러 지출(카테고리·재고·방별 분할)로 쪼개질 때 묶는다.
// 배송비는 그 주문에 연결된 별도 지출(Expense.isShipping)로 등록.
// 화면 표시 라벨 "대표품목 외 N건" 은 묶인 라인에서 실시간 계산(저장 안 함).
model ExpenseOrder {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code         String   // 자동 생성 'YYMMDD-NNN' (propertyId·일자별 순번)
  externalOrderNo String? // 쇼핑몰(쿠팡 등) 실제 주문번호 — 영수증 OCR/수동 입력. 진위확인·재주문 참조용(보조)
  shippingType String?  // 배송비 결제구분: '선불' | '착불' | '신용'
  shippingMemo String?  // 결제수단·비고 등 자유 메모
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expenses     Expense[]

  @@index([propertyId, createdAt])
  @@map("expense_orders")
}

// ============================================================
// [12] ExtraIncome
// ============================================================

model ExtraIncome {
  id         String   @id @default(uuid()) @db.Uuid
  date       DateTime @db.Date
  amount     Int
  category   String
  detail     String?
  memo       String?
  payMethod  String?
  receiptUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime? // 소프트삭제 — null=활성. 조회는 prisma 소프트삭제 익스텐션이 자동 필터.

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  financialAccountId String?           @db.Uuid
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id])

  // 입주자 연결(선택) — 과납분·보증금 미반환분처럼 수납에서 파생된 수익을 그 사람/계약에 묶는다.
  // (2026-07-02: 부가수익을 수납관리로 이동하며 보강. 자판기 등 무관 수입은 null.)
  tenantId    String?    @db.Uuid
  tenant      Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  leaseTermId String?    @db.Uuid
  leaseTerm   LeaseTerm? @relation(fields: [leaseTermId], references: [id], onDelete: SetNull)

  @@index([propertyId, date])
  @@index([tenantId])
  @@map("extra_incomes")
}

// ============================================================
// [12-1] ReserveTransaction — 예비비 (수선/비상자금 적립금)
// 자기자본 내 적립으로, 보증금(부채)·일반 지출(비용)과 구분.
// type:
//   DEPOSIT                — 자금에서 예비비로 적립 (잔고 +)
//   WITHDRAW_DIRECT        — 예비비에서 직접 지출 (잔고 -). 별도 Expense 미생성.
//   WITHDRAW_FROM_EXPENSE  — 일반 지출 사후정산 (잔고 -). expenseId로 원본 지출 연결.
// 잔고 = SUM(DEPOSIT) - SUM(WITHDRAW_*).
// ============================================================

model ReserveTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   // 'DEPOSIT' | 'WITHDRAW_DIRECT' | 'WITHDRAW_FROM_EXPENSE'
  amount      Int      // 항상 양수. type으로 부호 결정
  date        DateTime @db.Date
  sourceMonth String?  // DEPOSIT일 때만 사용. "YYYY-MM" 형식. 어느 달 자금에서 적립했는지
  category    String?  // 사용 분류(예: 시설 파손, 가전 교체)
  memo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  expenseId String?  @db.Uuid
  expense   Expense? @relation("ExpenseReserveSettlement", fields: [expenseId], references: [id], onDelete: SetNull)

  // 이체 대상/출금 계좌
  // DEPOSIT: 적립금이 들어간 계좌 (예: '예비비 계좌')
  // WITHDRAW_DIRECT: 예비비를 인출해 쓴 계좌
  // WITHDRAW_FROM_EXPENSE: null (원 expense의 financialAccount 활용)
  linkedAccountId String?           @db.Uuid
  linkedAccount   FinancialAccount? @relation("ReserveLinkedAccount", fields: [linkedAccountId], references: [id], onDelete: SetNull)

  @@index([propertyId, date])
  @@index([propertyId, type])
  @@map("reserve_transactions")
}

// ============================================================
// [12-2] DepositRefund — 보증금 환불 이력
// 입금은 PaymentRecord(isDeposit=true)에 기록되어 있고,
// 환불(반환·미반환분)은 별도 거래로 명시화해 보증금 흐름을 양방향 추적.
// returnedAmount + withheldAmount = 처리한 보증금 총액 (보통 LeaseTerm.depositAmount).
// 미반환분(withheldAmount)은 ExtraIncome(category='보증금')으로 동시에 잡혀 매출 인식됨.
// ============================================================

model DepositRefund {
  id              String   @id @default(uuid()) @db.Uuid
  date            DateTime @db.Date
  returnedAmount  Int      @default(0)  // 실제 반환한 금액
  withheldAmount  Int      @default(0)  // 미반환분(공제). ExtraIncome으로도 기록됨
  reason          String?  // 공제/감액 사유
  memo            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leaseTermId String    @db.Uuid
  leaseTerm   LeaseTerm @relation(fields: [leaseTermId], references: [id], onDelete: Cascade)

  @@index([propertyId, date])
  @@index([leaseTermId])
  @@map("deposit_refunds")
}

// ============================================================
// [13] TenantStatusLog
// ============================================================

model TenantStatusLog {
  id         String      @id @default(uuid()) @db.Uuid
  fromStatus LeaseStatus
  toStatus   LeaseStatus
  reason     String?
  memo       String?
  changedAt  DateTime    @default(now())

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leaseTermId String?    @db.Uuid
  leaseTerm   LeaseTerm? @relation(fields: [leaseTermId], references: [id])

  changedById String? @db.Uuid
  changedBy   User?   @relation(fields: [changedById], references: [id])

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId, changedAt])
  @@index([propertyId, changedAt])
  @@index([propertyId, toStatus])
  @@map("tenant_status_logs")
}

// ============================================================
// [14] TenantRequest
// ============================================================

model TenantRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content        String
  requestDate    DateTime  @default(now()) @db.Date
  targetDate     DateTime? @db.Date
  resolvedAt     DateTime?
  resolutionMemo String?
  category       String?
  isUrgent       Boolean   @default(false)
  commonPlace    String?   // 공용부 요청 시 위치 설명 (예: "공용 주방", "1층 화장실")
  roomNoSnapshot String?   // 등록 시점 호실번호 — 이사·퇴실 후에도 '당시 호실' 표기 유지. null=구 데이터(동적 폴백)
  deletedAt      DateTime? // 소프트삭제 — null=활성, 값=삭제됨(적용취소 가능). 모든 조회는 deletedAt:null 필터.
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenantId   String? @db.Uuid
  tenant     Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, resolvedAt])
  @@index([tenantId, createdAt])
  @@map("tenant_requests")
}

// ============================================================
// [15] MarketSurvey
// ============================================================

model MarketSurvey {
  id         String   @id @default(uuid()) @db.Uuid
  surveyedAt DateTime @default(now())
  strategy   String?  // '실속형' | '시세형' | '프리미엄형'
  aiResult   String?  // JSON string from Gemini
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  propertyId  String            @db.Uuid
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  competitors MarketCompetitor[]

  @@index([propertyId, surveyedAt])
  @@map("market_surveys")
}

// ============================================================
// [16] MarketCompetitor
// ============================================================

model MarketCompetitor {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  address        String
  naverPlaceUrl  String?
  roomPrices     Json         // [{type: string, price: number, memo?: string}]
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  marketSurveyId String       @db.Uuid
  marketSurvey   MarketSurvey @relation(fields: [marketSurveyId], references: [id], onDelete: Cascade)

  @@map("market_competitors")
}

// ============================================================
// [17] RecurringExpense
// ============================================================

model RecurringExpense {
  id              String    @id @default(uuid()) @db.Uuid
  propertyId      String    @db.Uuid
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  groupSourceIds  Json?     // 묶기로 만든 부모일 때 원본 정기지출 id 목록 — 묶기 해제용(감사 백로그 2026-07-10)
  title           String
  amount          Int
  category        String
  dueDay          Int
  payMethod           String?
  vendor              String?   // 구매처(청구 기관 — 한전·수도 등). 기록 시 지출 vendor 로 전파(신고 6d1cf1ea)
  financialAccountId  String?   @db.Uuid
  financialAccount    FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  isAutoDebit     Boolean   @default(false)
  isVariable      Boolean   @default(false)
  alertDaysBefore Int       @default(7)
  isActive        Boolean   @default(true)
  activeSince     DateTime? @db.Date
  priorYearAmount Int?
  // 변동 고정지출에서 청구 금액을 미리 알았을 때 임시 저장 — 결제일에 처리할 예약 금액.
  // 실제 지출(Expense)은 생성하지 않음. 결제일 알림 모달에서 prefill되어 한 번 더
  // 확인 후 기록되며, 기록 시 이 필드는 자동 클리어된다.
  pendingAmount   Int?
  memo            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expenses        Expense[]
  // #1 관리비 묶음: 세부항목(있으면 이 고정지출은 '부모/묶음'). 합계 = 세부 amount 합, 변동 = 하나라도 변동.
  items           RecurringExpenseItem[]

  @@index([propertyId])
  @@map("recurring_expenses")
}

// #1 고정지출 세부항목 — 예: '관리비' 부모 아래 청소관리비(고정)·수도요금(변동) 등.
// 부모(RecurringExpense)의 amount/isVariable 은 이 항목들로부터 파생(서버에서 동기화).
model RecurringExpenseItem {
  id                 String           @id @default(uuid()) @db.Uuid
  recurringExpenseId String           @db.Uuid
  recurringExpense   RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  name               String
  amount             Int              @default(0)   // 고정이면 그 금액, 변동이면 기본/직전 추정액
  isVariable         Boolean          @default(false)
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([recurringExpenseId])
  @@map("recurring_expense_items")
}

// ============================================================
// [18] TrackedItem — 부식·소모품·폐기물 사용량 추적 대상
// ============================================================

model TrackedItem {
  id                  String          @id @default(uuid()) @db.Uuid
  propertyId          String          @db.Uuid
  property            Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category            String          // 부식비 / 소모품비 / 폐기물 처리비
  label               String          // 화장실 휴지, 종량제쓰레기봉투 등
  specUnit            String?         // m, L, kg 등
  qtyUnit             String?         // 롤, 매, 포대 등
  alertThresholdDays  Int             @default(7)   // 소진 예상이 N일 이하면 대시보드 알림 (기본 7일 — 운영자 승인 2026-08-06, 리드타임+2 와 max 로 병용)
  reorderMemo         String?                       // 발주처 / 주문 단위 / 비고
  purchaseUrl         String?                       // 구매 링크 (쿠팡·아마존 등) — 앱에서 바로 열기. 추후 제휴 링크 활용 여지
  trackUnit           String          @default("spec") // "spec"=규격(kg/ml/매×qty)으로 추적, "qty"=수량(매/개) 단위로 추적. 폐기물 봉투처럼 50L×30매를 1500L 아닌 30매로 트래킹할 때 'qty'
  // 이 품목의 창고(허브) 위치 — 품목마다 다름(김치=김치냉장고 하단, 라면=415호 창고 등).
  // null 이면 영업장 기본 허브(StorageLocation.isHub)로 폴백. 보충 시 이 위치에서 차감.
  hubLocationId       String?         @db.Uuid
  isArchived          Boolean         @default(false)
  sortOrder          Int?      // 사용자 지정 순서(카테고리 내). 드래그 저장 시 그 카테고리 전 품목에 인덱스 기록. null 카테고리는 가나다순(nulls last)
  memo                String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  stockChecks  StockCheck[]
  additions    StockAddition[]
  disposals    StockDisposal[]
  locations    TrackedItemLocation[]
  checkDrafts  StockCheckDraft[]

  @@unique([propertyId, category, label])
  @@index([propertyId, isArchived])
  @@map("tracked_items")
}

// 재고 점검 기록 — 특정 시점의 잔량
model StockCheck {
  id             String      @id @default(uuid()) @db.Uuid
  trackedItemId  String      @db.Uuid
  trackedItem    TrackedItem @relation(fields: [trackedItemId], references: [id], onDelete: Cascade)
  date           DateTime    @db.Date
  remainingQty   Float       // 전체 잔량 합계 (위치별 합산 or 단일 입력)
  memo           String?
  createdAt      DateTime    @default(now())
  // 전체 재고 보정(총점검)으로 생성된 점검. 실측을 새 기준선으로 박되, 사용량 계산에서는
  // 이 점검 직전 구간의 차이를 '소모'로 잡지 않는다(보정=리셋, 차이는 분실/오차로 간주).
  isReconcile    Boolean     @default(false)
  // confirmReceipt가 자동 생성한 점검이면 원본 지출(=구매)에 연결.
  // 사용자가 receivedAt을 수정하면 이 link로 자동 점검의 date를 동기화하고, receivedAt이 null이 되면 자동 점검을 삭제한다.
  sourceExpenseId String?    @db.Uuid
  sourceExpense   Expense?   @relation(fields: [sourceExpenseId], references: [id], onDelete: SetNull)

  locationBreakdown StockCheckLocation[]

  @@index([trackedItemId, date])
  @@index([sourceExpenseId])
  @@map("stock_checks")
}

// 점검 임시저장(드래프트) — '보충 전'만 입력하고 나중에 이어서 마무리하기 위한 폼 상태 보관.
// StockCheck 와 별도 테이블이라 실제 잔량/이력 계산엔 전혀 영향 없음. 항목+위치당 1개.
model StockCheckDraft {
  id            String      @id @default(uuid()) @db.Uuid
  trackedItemId String      @db.Uuid
  trackedItem   TrackedItem @relation(fields: [trackedItemId], references: [id], onDelete: Cascade)
  locationId    String?     @db.Uuid   // 위치별 점검 드래프트면 그 위치, 아이템별 점검이면 null
  data          Json        // 폼 상태 스냅샷 { mode, beforeQtys, afterQtys, date, ... }
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())

  @@unique([trackedItemId, locationId])
  @@index([trackedItemId])
  @@map("stock_check_drafts")
}

// 병합 규칙 — 영수증→재고 자동등록 시 라벨↔카드 추천·거절 기억.
// kind="LINK": 이 라벨은 이 카드로 추천(과거 병합 이력/사용자 승인). 자동 병합이 아니라 후보 제시용.
// kind="MUTE": 이 (라벨, 카드) 쌍은 추천 안 함(사용자가 '새 품목으로' 거절). 관리 UI에서 되돌리기 가능.
// FK·관계는 SQL 마이그레이션에서 ON DELETE CASCADE 로 부여(스키마는 스칼라만 — 모델 churn 최소화).
model TrackedItemMergeRule {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @db.Uuid
  category     String
  sourceLabel  String   // 원본 라벨(표시용)
  normLabel    String   // 정규화 라벨(매칭용 — 공백·괄호·규격표기 제거)
  targetItemId String   @db.Uuid
  kind         String   // "LINK" | "MUTE"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([propertyId, category, normLabel, targetItemId])
  @@index([propertyId, category])
  @@map("tracked_item_merge_rules")
}

// 병합 되돌리기용 복원 정보 — 병합 시 1행 기록. '병합 해제'가 payload로 원상복구.
// payload.kind = 'IMPORT'(자동등록 병합: 지출 라벨만 이전) | 'CARD'(두 카드 병합: source 카드 삭제)
model TrackedItemMergeUndo {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @db.Uuid
  targetItemId String   @db.Uuid   // 병합된 대상(흡수한) 카드
  label        String                // 표시용 "원라벨 → 대상라벨"
  payload      Json                  // 복원 데이터 (kind별 상이)
  createdAt    DateTime @default(now())

  @@index([propertyId])
  @@map("tracked_item_merge_undos")
}

// 웹 푸시(PWA) 구독 — 기기별 1행. 대시보드 알림을 폰으로 푸시.
// FK(userId→users)는 SQL 마이그레이션에서 ON DELETE CASCADE 로 부여(스키마는 스칼라만).
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String   // 구독 공개키
  auth      String   // 구독 auth secret
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

// "찍어 올리고 분류는 AI 가" — 사용자가 영수증/관련 사진을 찍어 업로드하면 OCR + 분류 추론을 거쳐
// 등록 대기 큐에 적재. 사용자가 검토 후 승인하면 해당 도메인(지출/재고)에 정식 등록.
model PendingReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  propertyId      String   @db.Uuid
  uploaderId      String   @db.Uuid
  imageUrl        String                            // Drive 썸네일 URL (즉시 표시용)
  driveFileId     String?                           // Drive 영구 저장 id
  status          String   @default("pending")      // 'pending' | 'approved' | 'rejected'

  // OCR · 분류 추론 (Gemini)
  inferredKind    String?                           // 'expense' | 'inventory' | 'unknown'
  inferredVendor  String?
  inferredDate    String?                           // YYYY-MM-DD
  inferredAmount  Int?
  inferredCategory String?
  parsedJson      Json?                             // 원본 분석 JSON (편집/디버그용)

  // 처리 결과
  linkedExpenseId String?  @db.Uuid                 // 승인 시 생성된 expense id (있으면)

  createdAt       DateTime @default(now())
  reviewedAt      DateTime?

  @@index([propertyId, status, createdAt])
  @@map("pending_receipts")
}

// 푸시 발송 내역 — 사용자별 1행 per 발송 이벤트(기기당 아니라 발송 단위).
// cron 매일 알림 / 테스트 / 추후 카테고리들이 남는다. 설정 페이지에서 최근 N건 표시.
model PushHistory {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  source        String   // 'cron-daily' | 'test'
  title         String
  body          String
  url           String?
  badge         Int?
  tag           String?
  endpointCount Int      @default(0)  // 시도한 기기 수
  successCount  Int      @default(0)  // 성공한 기기 수
  sentAt        DateTime @default(now())

  @@index([userId, sentAt])
  @@map("push_history")
}

// 보관 위치 — 창고 / 4층 주방 / 손님실 선반 등 property-level 마스터
model StorageLocation {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int      @default(0)
  isHub      Boolean  @default(false)  // true = 창고/허브 역할 (위치별 점검 시 이동 수량 추적용)
  createdAt  DateTime @default(now())

  trackedItems        TrackedItemLocation[]
  stockCheckLocations StockCheckLocation[]
  transferSources     StockCheckLocation[] @relation("StockTransferSource")
  receivedExpenses    Expense[]            @relation("ExpenseReceivedLocation")
  assignedExpenses    Expense[]            @relation("ExpenseAssignedLocation")
  stockAdditions      StockAddition[]
  stockDisposals      StockDisposal[]

  @@unique([propertyId, name])
  @@index([propertyId, sortOrder])
  @@map("storage_locations")
}

// 품목 ↔ 위치 M:N — 이 품목이 어느 위치에 보관되는지
model TrackedItemLocation {
  trackedItemId     String @db.Uuid
  storageLocationId String @db.Uuid
  // null = 표시(열림). 값 = 이 품목에서 이 위치를 숨긴 시점.
  // 숨김은 (품목,위치) 쌍의 속성 — StorageLocation 은 영업장 공용이라 안 지운다.
  // 표시 술어: closedAt != null 이고 그 위치의 현재 잔량이 비었으면(< 0.001) 화면에서 가린다(재고 들어오면 자동 재표시).
  closedAt          DateTime?

  trackedItem     TrackedItem     @relation(fields: [trackedItemId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)

  @@id([trackedItemId, storageLocationId])
  @@map("tracked_item_locations")
}

// 점검 시 위치별 잔량 — StockCheck.remainingQty = sum(이 테이블의 remainingQty)
//
// remainingQty: 점검 시점의 "채운 후" 잔량 (보충했다면 보충 후 수량, 안 했으면 실측 수량)
// restockedQty: 이번 점검에서 이 위치에 보충한 양 — "채우기 전" 잔량 = remainingQty - restockedQty.
//               합계만큼 허브 위치의 remainingQty에서 자동 차감됨 (액션 단계에서 처리).
// fromHubQty/fromLocationId: (레거시) 명시적 위치 간 이동 수량 — 기존 데이터 호환용,
//               신규 UI는 restockedQty를 사용하고 허브 자동 차감으로 대체.
model StockCheckLocation {
  id                String @id @default(uuid()) @db.Uuid
  stockCheckId      String @db.Uuid
  storageLocationId String @db.Uuid
  remainingQty      Float
  restockedQty      Float?  // 이번 점검에서 이 위치에 보충한 양 (NULL = 보충 없음)
  fromHubQty        Float?  // (레거시) 명시적 이동 유입 수량
  fromLocationId    String? @db.Uuid  // (레거시) 이동 유입 출처

  stockCheck      StockCheck       @relation(fields: [stockCheckId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation  @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)
  fromLocation    StorageLocation? @relation("StockTransferSource", fields: [fromLocationId], references: [id])

  @@unique([stockCheckId, storageLocationId])
  @@map("stock_check_locations")
}

// 무상 입수/이월 등 — 지출 외 추가 입고
model StockAddition {
  id                String           @id @default(uuid()) @db.Uuid
  trackedItemId     String           @db.Uuid
  trackedItem       TrackedItem      @relation(fields: [trackedItemId], references: [id], onDelete: Cascade)
  date              DateTime         @db.Date
  addedQty          Float            // qtyUnit 기준 수량
  source            String?          // 무상/기증/이월/기타
  memo              String?
  storageLocationId String?          @db.Uuid  // 입고된 위치 (지출 수령과 같은 단일 위치 패턴)
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  @@index([trackedItemId, date])
  @@map("stock_additions")
}

// 폐기 이벤트 — StockAddition(유입)의 거울(유출). 소비량 역산에서 폐기를 소모와 분리(오류신고 a1e048e8).
model StockDisposal {
  id                String           @id @default(uuid()) @db.Uuid
  trackedItemId     String           @db.Uuid
  trackedItem       TrackedItem      @relation(fields: [trackedItemId], references: [id], onDelete: Cascade)
  date              DateTime         @db.Date
  disposedQty       Float            // qtyUnit 기준 수량
  reason            String?          // 상함·유통기한·파손·기타
  memo              String?
  storageLocationId String?          @db.Uuid  // 폐기가 발생한 위치(선택)
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  @@index([trackedItemId, date])
  @@map("stock_disposals")
}

// ============================================================
// [19] Checklist — 운영 점검(부식 잔량/청소/소모품 등) 주기 To-Do
// ============================================================

model Checklist {
  id              String          @id @default(uuid()) @db.Uuid
  propertyId      String          @db.Uuid
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title           String                              // "부식 잔량 확인"
  memo            String?                             // 상세 / 위치 / 기준
  intervalDays    Int                                 // 확인 주기(일). 7=매주, 30=매월 등 프리셋도 같은 컬럼에 저장
  alertDaysBefore Int             @default(3)         // 도래일 N일 전부터 대시보드 알림
  lastCheckedAt   DateTime?                           // 마지막 점검 일시
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  logs            ChecklistLog[]

  @@index([propertyId, isActive])
  @@map("checklists")
}

// 체크리스트 점검 이력
model ChecklistLog {
  id           String     @id @default(uuid()) @db.Uuid
  checklistId  String     @db.Uuid
  checklist    Checklist  @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  checkedAt    DateTime   @default(now())
  checkedBy    String?    @db.Uuid                    // userId
  memo         String?

  @@index([checklistId, checkedAt])
  @@map("checklist_logs")
}
// ============================================================
// ContractFile — 입실자 서명된 계약서 파일 (PDF, Drive 보관)
// 같은 입실자에 대해 여러 파일 보관 가능 (재발행·갱신·스캔본 등)
// ============================================================

enum ContractFileSource {
  GENERATED  // 앱 내에서 서명 + 자동 생성된 PDF
  UPLOADED   // 종이로 출력해 사인 후 스캔 업로드
}

model ContractFile {
  id           String             @id @default(uuid()) @db.Uuid
  source       ContractFileSource @default(GENERATED)
  driveFileId  String                                       // Google Drive file ID
  fileName     String                                       // 표시용 파일명
  // 계약번호 YYYYMMDD-NNN — 영수증 발행번호와 같은 이유로 저장한다. 스캔 업로드본은 null 이다
  // (종전에는 업로드본까지 세어 다음 앱 발급본의 번호가 건너뛰었다).
  contractNo   String?
  signedAt     DateTime           @default(now())            // 서명 일시 (사용자가 입력한 서명일 또는 업로드 시각)
  deletedAt    DateTime?                                      // 소프트삭제 — null=활성, 값=삭제됨(적용취소). 조회는 deletedAt:null 필터.
  createdAt    DateTime           @default(now())

  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leaseTermId  String?  @db.Uuid
  leaseTerm    LeaseTerm? @relation(fields: [leaseTermId], references: [id], onDelete: SetNull)

  propertyId   String   @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, contractNo])
  @@index([tenantId, createdAt])
  @@index([propertyId, createdAt])
  @@map("contract_files")
}

// 계약서 원격 서명 링크 — 발급 시점 렌더 데이터(templateSnapshot)를 고정해 입주자에게 24시간 링크 제공.
// 생년월일 5회 오류 시 lockedAt, 운영자 닫기 closedAt(만료 전 적용취소 가능). 서명은 LeaseTerm 서명 필드에 기록.
model ContractShareLink {
  id                String    @id @default(uuid()) @db.Uuid
  token             String    @unique
  templateSnapshot  Json      // 발급 시점 ContractData 전체 — 원격 화면은 이 스냅샷만 렌더
  expiresAt         DateTime
  closedAt          DateTime? // 운영자 링크 닫기 (만료 전 reopen 가능)
  submittedAt       DateTime? // 원격 제출 확정(자동 잠금) — closedAt(무산 닫기)과 구분해 '정식 계약서 발급' 리마인더가 발급 전까지 유지되게(운영자 승인 2026-07-23)
  signedAt          DateTime? // 원격 계약서 서명 수신 시각
  disposalSignedAt  DateTime? // 원격 동의서(잔여 소지품) 서명 수신 시각
  birthdateAttempts Int       @default(0)
  lockedAt          DateTime? // 생년월일 5회 오류로 잠김 — 재발급 필요
  createdBy         String?   @db.Uuid
  createdAt         DateTime  @default(now())

  propertyId  String    @db.Uuid
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leaseTermId String    @db.Uuid
  leaseTerm   LeaseTerm @relation(fields: [leaseTermId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([propertyId, createdAt])
  @@map("contract_share_links")
}

// 실거주 확인서 — 입실자별 발급 PDF (계약서와 동일 구조). 발급 시 Drive 업로드 + 이력 보관.
model ResidenceCertFile {
  id           String   @id @default(uuid()) @db.Uuid
  driveFileId  String                            // Google Drive file ID
  fileName     String                            // 표시용 파일명
  issuedAt     DateTime @default(now())          // 작성(발급)일 — 사용자가 입력한 작성일
  deletedAt    DateTime?                         // 소프트삭제 — null=활성, 값=삭제됨(적용취소).
  createdAt    DateTime @default(now())

  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leaseTermId  String?  @db.Uuid
  leaseTerm    LeaseTerm? @relation(fields: [leaseTermId], references: [id], onDelete: SetNull)

  propertyId   String   @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([propertyId, createdAt])
  @@map("residence_cert_files")
}

// 발급 서류 표시값 오버라이드 — 서류별 한 행(운영자 승인 2026-08-08).
// 세 서류는 서로 다른 사실을 말하므로 값을 공유하지 않는다. 계약서는 별도 칸
// (LeaseTerm.contractFieldOverrides)을 그대로 쓰고, 나머지 서류가 이 테이블을 쓴다.
// 서류별로 행을 나눈 이유 — 칼럼 하나에 모으면 두 서류 동시 저장에서 lost update 가 나고,
// 서류별 updatedAt 이 없어 "언제 저장한 값인가"를 말해 줄 수 없다.
// fields 는 sparse JSON 이고 자동값과 같아진 키는 저장되지 않는다(lib/documentFieldOverrides 가 정본).
model DocumentFieldOverride {
  id          String   @id @default(uuid()) @db.Uuid
  docType     String                              // 'RESIDENCE_CERT'
  fields      Json                                // sparse — 존재하는 키만 자동값을 덮는다
  updatedBy   String?  @db.Uuid                   // 마지막으로 저장한 운영자 user id
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  leaseTermId String    @db.Uuid
  leaseTerm   LeaseTerm @relation(fields: [leaseTermId], references: [id], onDelete: Cascade)

  propertyId  String   @db.Uuid
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([leaseTermId, docType])
  @@index([propertyId, docType])
  @@map("document_field_overrides")
}

// 월세 영수증 — 입실자별 발급 PDF (외국인등록증 신청용 등). 실거주 확인서와 동일 구조.
model RentReceiptFile {
  id           String   @id @default(uuid()) @db.Uuid
  driveFileId  String
  fileName     String
  kind         String   @default("rent")         // 'rent'=입실료 납부 확인서 | 'deposit'=보증금 영수증 (같은 서식 가족)
  // 발행번호 YYYYMMDD-NNN — 저장해야 원장이 된다. 종전에는 count+1 로 그 자리에서 만들어 PDF 에
  // 그리기만 했고, 미리보기·보내기에도 같은 번호가 찍혀 소비되지 않은 채 종이로 나갔다.
  // 그 뒤 실제 발급본이 같은 번호를 갖고, 동시 발급이면 경합도 났다(E페이즈 조사 2026-08-03).
  receiptNo    String?
  issuedAt     DateTime @default(now())          // 발행일 — 사용자가 입력
  deletedAt    DateTime?                         // 소프트삭제 — null=활성, 값=삭제됨(적용취소).
  createdAt    DateTime @default(now())

  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leaseTermId  String?  @db.Uuid
  leaseTerm    LeaseTerm? @relation(fields: [leaseTermId], references: [id], onDelete: SetNull)

  propertyId   String   @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, receiptNo])
  @@index([tenantId, createdAt])
  @@index([propertyId, createdAt])
  @@map("rent_receipt_files")
}

// ============================================================
// [14] InviteCode — 초대코드/쿠폰 (선착순 N명 무료 베타)
// ============================================================

model InviteCode {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  note        String?   // 메모(용도 표시)
  maxUses     Int       @default(1)    // 선착순 N명. 0 이하면 무제한
  usedCount   Int       @default(0)
  autoApprove Boolean   @default(true) // 코드로 가입 시 자동 승인 여부
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.Uuid       // 발급한 운영자 user id

  @@map("invite_codes")
}

// ============================================================
// [15] JoinRequest — 영업장 참여 요청 (D)
// ============================================================
// 사용자가 영업장 참여 코드를 입력 → 운영자가 승인하면 UserPropertyRole 생성.
// 거절 후 재요청 가능(동일 record를 PENDING으로 갱신). 한 (영업장, 사용자) 쌍에 record 하나.

model JoinRequest {
  id          String            @id @default(uuid()) @db.Uuid
  propertyId  String            @db.Uuid
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      JoinRequestStatus @default(PENDING)
  role        UserRole          @default(STAFF)  // 승인 시 부여할 역할 (운영자가 결정)
  message     String?                            // 사용자가 적은 메모 (선택)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  decidedAt   DateTime?
  decidedBy   String?           @db.Uuid         // 승인/거절한 운영자 user id

  @@unique([propertyId, userId])
  @@index([propertyId, status])
  @@map("join_requests")
}

// ============================================================
// [16] PageView — 공개 랜딩 페이지(/members/<slug>) 트래픽 (G 인앱 트래킹)
// ============================================================
// 정적 HTML head 의 작은 스크립트가 POST /api/track/pageview 로 보냄.
// 익명·집계 위주(개인 식별 X): visitorHash = IP+UA 1방향 해시.

model PageView {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String                          // /members/<slug> 의 slug — Property.publicSlug 와 매칭
  path         String                          // 실제 경로 (확장 대비, 보통 '/members/<slug>/')

  occurredAt   DateTime @default(now())

  // 유입 출처
  referrer     String?                         // 원본 document.referrer (디버그용)
  referrerHost String?                         // 호스트만 ('instagram.com', 'google.com', null=직접)
  searchEngine String?                         // 분류 결과: '구글'·'네이버'·'다음'·'빙'·'유튜브'·'인스타'·'페북'·'트위터'·'카카오'·null
  referrerCategory String?                     // 'search'·'social'·'direct'·'other'

  // UTM
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?

  // 위치 (Vercel x-vercel-ip-* 헤더 — 도시 단위 정확도)
  country      String?                         // 'KR'·'US' (ISO 3166-1 alpha-2)
  region       String?                         // 행정구역
  city         String?                         // 도시명

  // 디바이스/브라우저 (User-Agent 파싱)
  os           String?                         // 'iOS'·'Android'·'Windows'·'macOS'·'Linux'
  osVersion    String?                         // '17.1'·'14'·'11'
  browser      String?                         // 'Chrome'·'Safari'·'Firefox'·'Edge'·'Samsung'
  browserVersion String?                       // '130'
  deviceType   String?                         // 'mobile'·'tablet'·'desktop'

  // 화면 (클라이언트 JS)
  screenWidth   Int?
  screenHeight  Int?
  viewportWidth Int?
  viewportHeight Int?
  language      String?                        // 'ko-KR'

  // 참여도 (페이지 닫을 때 sendBeacon 으로 업데이트 — 별도 endpoint)
  durationMs    Int?                           // 체류 시간 (밀리초) — 벽시계(백그라운드 포함), 레거시
  activeMs      Int?                           // 활성 체류(백그라운드 제외) — durationMs 의 방치탭 오염을 뺀 값(전문가 지적)
  scrollDepthPct Int?                          // 0-100, 최대 스크롤 깊이
  scrollMilestones Json?                       // { "25": ms, "50": ms, "75": ms, "100": ms } 처음 도달 시각(입장 기준) — 섹션 높이 비의존 축
  sectionDwellMs Json?                         // 섹션별 체류 시간 { sectionId: ms } — 페이지 어느 영역에 오래 머물렀나
  // CTA 클릭 — 전화·문자 링크. [{ kind:'tel'|'sms', section, tMs }]. 전환의 유일한 직접 신호(기존엔 미측정)
  ctaClicks     Json?
  // 갤러리 시트 열람 — 등급별 [{ rent, n(사진수), seen[](노출 인덱스), maxDepth, dwell{idx:ms} }].
  // 어떤 등급의 몇 번째 사진을 오래 봤나(전문가: 사진별 도달률·스와이프 깊이·체류가 진짜 신호). 2026-07-25
  galleryViews  Json?
  // 프로모션 팝업 열람 — { shownAtMs, dwellMs, close:'x'|'scrim'|'esc'|'today'|'cta_kakao'|'cta_rooms'|'leave', ctas:[{kind,tMs}], suppressed? }.
  // 얼마나 자세히 봤나 = 체류 + 닫기 방식 + CTA(분석 전문가 오더, 운영자 승인 2026-07-30). suppressed = 당일 억제로 미노출.
  popupView     Json?

  // 클라이언트 (원본 보존용 — 디버그)
  userAgent    String?
  isMobile     Boolean  @default(false)        // 이전 호환 (deviceType='mobile' 와 동일)

  // 익명 식별자 (방문자 추정용)
  visitorHash  String?

  // 접속 IP — 방문 기록 상세에서만 조회한다(목록 select 에서 제외). 개인정보라 90일 지난 행은
  // 크론이 null 로 비운다(방문 기록·통계는 남고 IP 만 사라짐, 운영자 결정 2026-07-24).
  ip           String?

  // 봇 필터링 신호
  isBot        Boolean  @default(false)

  @@index([slug, occurredAt])
  @@index([slug, isBot, occurredAt])
  @@index([slug, country, occurredAt])
  @@map("page_views")
}

// 오류 신고 — 사용자가 오류 발생 즉시 신고(직전 동작 자취 + 자동 캡처 에러 + 메모).
// 새 세션 시작 시 open 건을 확인해 진행 여부를 운영자에게 묻는다. SQL 은 운영자가 직접 적용함.
model ErrorReport {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  propertyId  String?  @db.Uuid
  userEmail   String?
  url         String?
  userAgent   String?
  breadcrumbs Json?                              // 최근 동작 자취(이동·에러)
  errorText   String?                            // 자동 캡처된 에러 메시지
  userNote    String?                            // 사용자 설명
  imageFileIds Json?                             // 첨부 캡처 이미지 Drive 파일 ID 배열(최대 3장, 2026-07-27)
  status      String   @default("open")          // open | done | dismissed

  @@index([status, createdAt])
  @@map("error_reports")
}

// 비품 품목 표시 순서 — (propertyId, category, itemLabel) 별 사용자 지정 순서(순서 편집, 계산 무관)
model AssetItemOrder {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category   String
  itemLabel  String
  // 규격 식별자 직렬화(specValue␟specUnit␟specText, SpecKey 3종과 동일 정체성) — '' = 라벨(품목) 순서 행.
  // 라벨 내 규격(색상 등) 간 순서 편집용 2계층(운영자 승인 2026-07-20, 신고 1b8e7030). null 대신 '' 센티널(unique 정합).
  specKey    String   @default("")
  sortOrder  Int
  createdAt  DateTime @default(now())

  @@unique([propertyId, category, itemLabel, specKey])
  @@index([propertyId, category])
  @@map("asset_item_order")
}

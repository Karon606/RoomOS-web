/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 비밀 키·로컬 백업 (절대 커밋 금지)
RoomOS.zip
client_secret_*.json
roomos-*-*.json

# 백필 원본 스냅샷 — 되돌리기용 로컬 파일(개인정보는 없지만 저장소에 둘 이유도 없다)
scripts/.backfill-*.json

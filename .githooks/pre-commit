#!/bin/sh
# 커밋 시 지침 문서를 옵시디언 볼트(knowledge/refs/)로 자동 미러링 — 원본이 정본, 사본은 읽기용.
# (운영자 요청 2026-07-11: CLAUDE.md·AGENTS.md를 옵시디언에서도 보이게)
ROOT="$(git rev-parse --show-toplevel)"
REFS="$ROOT/knowledge/refs"
mkdir -p "$REFS"

mirror() {
  src="$1"; dst="$2"; title="$3"
  [ -f "$src" ] || return 0
  {
    printf '> [!note] 자동 사본 — 원본: `%s` (수정은 원본에서, 커밋 시 자동 갱신)\n\n' "$title"
    cat "$src"
  } > "$dst.tmp" && mv "$dst.tmp" "$dst"
  git add "$dst" 2>/dev/null
}

mirror "$ROOT/AGENTS.md" "$REFS/AGENTS(프로젝트 규칙).md" "저장소 루트 AGENTS.md"
mirror "$HOME/.claude/CLAUDE.md" "$REFS/CLAUDE(전역 행동지침).md" "~/.claude/CLAUDE.md"
mirror "$ROOT/loop.md" "$REFS/loop(검증 규칙).md" "저장소 루트 loop.md"

# ── 빠른 감지망 (DB 불필요, 합계 약 1.3초) ───────────────────────────────
# 감지망은 만들어만 두면 안 돌아간다 — 그동안 사람이 매번 손으로 실행해야 잡혔다(F페이즈에서 확인).
# 여기엔 DB·네트워크가 필요 없는 것만 둔다. DB 대조는 pre-push 로.
# 급할 때: git commit --no-verify · 전체 건너뛰기: STAYEUM_SKIP_HOOKS=1
if [ "$STAYEUM_SKIP_HOOKS" = "1" ]; then
  echo "[감지망] STAYEUM_SKIP_HOOKS=1 — 건너뜀"
  exit 0
fi

cd "$ROOT" || exit 0

# 목록은 package.json 의 verify:fast 가 정본이다 — 훅이 자기 목록을 따로 들면 갈린다.
# 실제로 갈렸다(G-4 2026-08-03): 훅에만 있던 것 2종, verify:fast 에만 있던 것 1종.
# 여기서 스크립트 이름을 나열하지 말 것.
if ! out="$(npm run --silent verify:fast 2>&1)"; then
  echo "$out" | tail -30
  echo ""
  echo "커밋을 중단했습니다. 위 감지망이 회귀를 잡았습니다."
  echo "의도한 변경이라면 기대값을 먼저 고치세요(규칙 변경은 loop.md 4번 = 운영자 승인 대상)."
  echo "정말 그대로 커밋하려면: git commit --no-verify"
  exit 1
fi
echo "[감지망] 빠른 검사 통과 (npm run verify:fast)"
exit 0
